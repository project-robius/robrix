<html>

<head>
    <style>
        @media (prefers-color-scheme: dark) {
            body {
                background: #333;
                color: white;
            }
            a {
                color: skyblue;
            }
        }
        .container {
            font-family: sans-serif;
            max-width: 800px;
            margin: 0 auto;
        }
        .intro {
            text-align: center;
        }
        .licenses-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        .license-used-by {
            margin-top: -10px;
        }
        .license-text {
            max-height: 200px;
            overflow-y: scroll;
            white-space: pre-wrap;
        }
        /* Having nothing to disclose is the normal case, so don't leave a bare heading. */
        .undetermined:not(:has(li)) {
            display: none;
        }
    </style>
</head>

<body>
    <main class="container">
        <div class="intro">
            <h1>Robrix — Third Party Licenses</h1>
            <p>This page lists the full license text of every third-party crate compiled into Robrix.</p>
        </div>
    
        <h2>Overview of licenses:</h2>
        <ul class="licenses-overview">
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <section class="undetermined">
            <h2>Crates with no license information:</h2>
            <p>No <code>license</code> field and no license file could be found for these, so their
            terms aren't reproduced below. They're listed here rather than dropped silently.</p>
            <ul>
                {{#each crates}}{{#if (eq license "Unknown")}}
                <li><a href="{{#if package.repository}} {{package.repository}} {{else}} https://crates.io/crates/{{package.name}} {{/if}}">{{package.name}} {{package.version}}</a></li>
                {{/if}}{{/each}}
            </ul>
        </section>

        <h2>All license text:</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li class="license">
                <h3 id="{{id}}">{{name}}</h3>
                <h4>Used by:</h4>
                <ul class="license-used-by">
                    {{#each used_by}}
                    <li><a href="{{#if crate.repository}} {{crate.repository}} {{else}} https://crates.io/crates/{{crate.name}} {{/if}}">{{crate.name}} {{crate.version}}</a></li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>
